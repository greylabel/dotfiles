# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs
# editorconfig.org
#
# Linked to ~/.editorconfig, so it applies to any project without its own.

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_size = 4

[{Makefile,*.mk,*.go}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
