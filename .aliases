#!/usr/bin/env bash

# Aliases below intentionally expand variables when defined.
# shellcheck disable=SC2139

# Easier navigation: .., ..., ...., ....., ~ and -
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ~="cd ~" # `cd` is probably faster to type though
alias -- -="cd -"

# Shortcuts
alias dl="cd ~/Downloads"
alias dt="cd ~/Desktop"
alias p="cd ~/Projects"
alias g="git"

# File colours from the terminal's (Tokyo Night) palette: directories blue,
# links cyan, executables green, archives red, media magenta. LS_COLORS is
# also read by GNU ls, tree and fd; LSCOLORS is the same scheme for macOS ls.
export LS_COLORS='no=00:fi=00:di=01;34:ln=01;36:pi=33:so=01;35:do=01;35:bd=01;33:cd=01;33:or=01;31:ex=01;32:*.tar=01;31:*.tgz=01;31:*.arj=01;31:*.taz=01;31:*.lzh=01;31:*.zip=01;31:*.z=01;31:*.Z=01;31:*.gz=01;31:*.bz2=01;31:*.deb=01;31:*.rpm=01;31:*.jar=01;31:*.jpg=01;35:*.jpeg=01;35:*.gif=01;35:*.bmp=01;35:*.pbm=01;35:*.pgm=01;35:*.ppm=01;35:*.tga=01;35:*.xbm=01;35:*.xpm=01;35:*.tif=01;35:*.tiff=01;35:*.png=01;35:*.mov=01;35:*.mpg=01;35:*.mpeg=01;35:*.avi=01;35:*.fli=01;35:*.gl=01;35:*.dl=01;35:*.xcf=01;35:*.xwd=01;35:*.ogg=01;35:*.mp3=01;35:*.wav=01;35:'
export LSCOLORS='ExGxFxdxCxDxDxabagacad'

# Detect which `ls` flavor is in use
if ls --color >/dev/null 2>&1; then # GNU `ls`
  colorflag="--color=auto"
else # macOS `ls`
  colorflag="-G"
fi

# List all files colorized in long format
alias l="ls -lF ${colorflag}"

# List all files colorized in long format, excluding . and ..
alias la="ls -lAF ${colorflag}"

# List all files in long format using human-readable units
alias ll="ls -laFh ${colorflag}"

# List only directories
alias lsd="ls -lF ${colorflag} | grep --color=never '^d'"

# Always use color output for `ls`
alias ls="command ls ${colorflag}"

# List current directory contents separated by null characters, suitable for piping to xargs -0
alias ls0="find . -maxdepth 1 -print0"

# Always enable colored `grep` output
alias grep='grep --color=auto'

# Enable aliases to be sudo’ed
alias sudo='sudo '

# Get week number
alias week='date +%V'

# Canonical hex dump; some systems have this symlinked
command -v hd >/dev/null || alias hd="hexdump -C"

# Recursively delete `.DS_Store` files
alias cleanup="find . -type f -name '*.DS_Store' -ls -delete"

# URL-encode strings
alias urlencode='python3 -c "import sys, urllib.parse as ul; print(ul.quote_plus(sys.argv[1]))"'

# Intuitive map function
# For example, to list all directories that contain a certain file:
# find . -name .gitattributes | map dirname
alias map="xargs -n1"

# Reload the shell (i.e. invoke as a login shell)
alias reload="exec ${SHELL} -l"

# Print each PATH entry on a separate line
alias path='echo -e ${PATH//:/\\n}'

# Verbose mv, rm, cp and human-readable sizes (humans only; see
# DOTFILES_HUMAN_SHELL in .bash_profile)
if [ -n "${DOTFILES_HUMAN_SHELL:-}" ]; then
  alias mv='mv -v'
  alias rm='rm -i -v' # Interactive
  alias cp='cp -v'
  alias mkdir='mkdir -p' # Create [p]arents if needed
  alias df='df -h'       # Human readable output
  alias du='du -h'       # Human readable output
fi

# Remove e[x]ecutable rights
alias chmox='chmod -x'

# Shorter pushd popd, and "oops I forgot to pushd"
alias gd=pushd
alias pd=popd
alias sd='pushd - && pushd'

# Shortcuts for frequent commands
alias home="cd ~/"
alias dr="df -P -kHl" # Diskspace report
alias h="history"
alias hosts='sudoedit /etc/hosts'
alias ungz="gunzip -k" # Keep input files

# Research profiles for curl and wget (see config/curl and config/wget)
alias rcurl="curl -K ${XDG_CONFIG_HOME:-$HOME/.config}/curl/research.curlrc"
alias rwget="wget --config ${XDG_CONFIG_HOME:-$HOME/.config}/wget/research.wgetrc"

# Docker
alias up="docker compose up"
alias down="docker compose down"

# pnpm
alias pn="pnpm"

# nvim
alias nv="nvim"

# macOS only
if [[ "$OSTYPE" == darwin* ]]; then
  # List with ACLs (macOS `ls -e`)
  alias le="ls -laFhe ${colorflag}"

  # iCloud Drive
  alias ic="cd ~/Library/Mobile\ Documents/com~apple~CloudDocs/"

  # Google Chrome
  alias chrome='/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome'

  # IP addresses (`ip` stays the iproute2 command on Linux)
  alias ip="dig +short myip.opendns.com @resolver1.opendns.com"
  alias localip="ipconfig getifaddr en0"
  alias ips="ifconfig -a | grep -o 'inet6\? \(addr:\)\?\s\?\(\(\([0-9]\+\.\)\{3\}[0-9]\+\)\|[a-fA-F0-9:]\+\)' | awk '{ sub(/inet6? (addr:)? ?/, \"\"); print }'"

  # Flush Directory Service cache
  alias flush="dscacheutil -flushcache && killall -HUP mDNSResponder"

  # Clean up LaunchServices to remove duplicates in the “Open With” menu
  alias lscleanup="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -kill -r -domain local -domain system -domain user && killall Finder"

  # JavaScriptCore REPL
  jscbin="/System/Library/Frameworks/JavaScriptCore.framework/Versions/A/Helpers/jsc"
  [ -e "${jscbin}" ] && alias jsc="${jscbin}"
  unset jscbin

  # Trim new lines and copy to clipboard
  alias c="tr -d '\n' | pbcopy"

  # Show/hide hidden files in Finder
  alias show="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
  alias hide="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"

  # Hide/show all desktop icons (useful when presenting)
  alias hidedesktop="defaults write com.apple.finder CreateDesktop -bool false && killall Finder"
  alias showdesktop="defaults write com.apple.finder CreateDesktop -bool true && killall Finder"
fi
